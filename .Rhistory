## creating many samples to test CIs
# creating empty vectors of size 50, each element will be a diff sample
samp_mean2 <- rep(NA, 50)
samp_sd2 <- rep(NA, 50)
##n <- 60 ## desired sample size
for (i in 1:50) {
samp <- sample(population, n) # creating new sample
samp_mean2[i] <- mean(samp) # saving mean to vector
samp_sd2[i] <- sd(samp) # saving sd to vector
}
lower_vector2 <- samp_mean2 - .8416212335 * samp_sd2 / sqrt(n)
upper_vector2 <- samp_mean2 + .8416212335 * samp_sd2 / sqrt(n)
# concatenating the lower and upper vectors
c(lower_vector2[1], upper_vector2[1])
## plot all 60% intervals
plot_ci(lower_vector2, upper_vector2, mean(population))
## finding proportion of CIs including the true pop mean
mu <- mean(population)
count_including_mu2 <- sum(lower_vector2 <= mu & upper_vector2 >= mu)
prop_include_mu2 <- count_including_mu2 / length(lower_vector2)
prop_include_mu2
