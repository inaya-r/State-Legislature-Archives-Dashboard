sec
new_names <- c(
new_names <- c(
grad_rate_4yr = "Graduation.rate...Bachelor.degree.within.4.years..total",
grad_rate_6yr = "Graduation.rate...Bachelor.degree.within.6.years..total",
institution = "institution.name",
sector = "Sector.of.institution"
)
IPEDs2 <- IPEDs %>%
# Select relevant columns
select(
institution.name,
Sector.of.institution,
Graduation.rate...Bachelor.degree.within.4.years..total,
Graduation.rate...Bachelor.degree.within.6.years..total
) %>%
# Filter for specific institution types
filter(Sector.of.institution %in% target_sectors) %>%
# Rename columns for clarity
rename(all_of(new_names)) %>%
# Calculate graduation rate difference
mutate(
grad_diff = grad_rate_6yr - grad_rate_4yr,
.after = grad_rate_6yr
)
View(IPEDs2)
# Verify the data transformation
cat("\nStructure of transformed data:\n")
glimpse(IPEDs2)
# Verify institution types
cat("\nDistribution of institution types:\n")
freqdist(IPEDs2$sector)
