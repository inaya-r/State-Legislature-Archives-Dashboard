# Define institution types we want to analyze
target_sectors <- c(
"Private not-for-profit, 4-year or above",
"Public, 4-year or above"
)
new_names <- c(
grad_rate_4yr = "Graduation.rate...Bachelor.degree.within.4.years..total",
